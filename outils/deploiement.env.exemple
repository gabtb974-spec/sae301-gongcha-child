# Paramètres de la production (mmi.unilim.fr) pour outils/deployer.sh.
# Copier ce fichier en outils/deploiement.env (non versionné) puis le compléter. Aucun mot de passe ici :
# SSH le demande à la connexion (une seule fois par déploiement).

# Connexion SSH : identifiant@serveur (et port si différent de 22)
PROD_SSH="identifiant@mmi.unilim.fr"
PROD_PORT="22"

# Dossier WordPress sur le serveur, RELATIF au dossier personnel (sans ~ ni / au début)
PROD_DIR="public_html/sae301"

# Adresse publique de ce dossier, sans / final
PROD_URL="https://mmi.unilim.fr/~identifiant/sae301"
